# Server configuration template. Copy to `.env` in the repository root; the
# server parses and validates it once at startup (server/src/config/index.ts).
# All values below are defaults or placeholders. Never commit a real `.env`.

# Server
# NODE_ENV defaults to development. Leave it unset on a server that runs the
# reference systemd unit: the unit sets NODE_ENV=production, and a value in
# this file (loaded through EnvironmentFile) would override it.
# NODE_ENV=development
PORT=3001

# MongoDB
# With authentication, put the user and password (user:password@) in front of
# the host and append ?authSource=defcon_explorer.
MONGODB_URI=mongodb://127.0.0.1:27017/defcon_explorer

# DeFCoN Core daemon RPC. RPC_PASS is required when NODE_ENV=production.
RPC_HOST=127.0.0.1
RPC_PORT=8193
RPC_USER=your_rpc_user
RPC_PASS=your_rpc_password
RPC_TIMEOUT=30000

# CORS (comma-separated list of allowed origins). The same list also decides
# which Origins may open the /ws WebSocket. In production, list the site's own
# public origin (e.g. https://example.com); otherwise realtime updates fail.
CORS_ORIGINS=http://localhost:5173

# Reverse proxy and rate limiting
# TRUST_PROXY = exact number of proxy hops in front of Node:
#   1 = nginx only (default)
#   2 = Cloudflare -> nginx -> Node
# Do not set it to `true` in production: that trusts every hop and lets a
# client spoof X-Forwarded-For to bypass per-IP rate limits.
TRUST_PROXY=1
RATE_LIMIT_MAX_PER_MINUTE=1200
# Headers checked (left to right) when resolving the client IP for rate
# limiting. nginx must overwrite these headers, not append to them; see the
# proxy_set_header lines in docs/server-config/nginx-deftrack.conf.
RATE_LIMIT_IP_HEADERS=cf-connecting-ip,x-real-ip

# Admin API (/api/admin/*). Leave empty to disable it: admin requests then
# return HTTP 500 (ADMIN_API_KEY_NOT_CONFIGURED). A configured key must be at
# least 32 characters long.
ADMIN_API_KEY=

# Base58Check version byte for P2PKH addresses, used to derive addresses for
# legacy pay-to-pubkey outputs (DeFCoN mainnet: 30, addresses start with "D").
# Optional: when unset, the server infers it from the chain and falls back to 30.
P2PKH_VERSION=30

# Sync
SYNC_INTERVAL_MS=10000
REORG_MAX_DEPTH=2000
# Allow an automatic explorer database wipe and full resync when the address
# index version changes; refused above AUTO_WIPE_MAX_DOCS documents.
ALLOW_DB_WIPE=false
AUTO_WIPE_MAX_DOCS=500000

# Cache and polling
CACHE_TTL_SECONDS=10
MN_POLL_INTERVAL_MS=300000

# Node inventory
NODE_INVENTORY_POLL_INTERVAL_MS=300000
# Nodes reporting an older wallet version are marked as deprecated.
NODE_INVENTORY_MIN_VERSION=23.0.0
NODE_INVENTORY_REQUEST_TIMEOUT_MS=6000
NODE_INVENTORY_FAILURE_BACKOFF_MS=30000
NODE_INVENTORY_STALE_MAX_AGE_MS=600000

# Optional external node feeds (JSON), e.g. from a DNS seeder / crawler host.
# There is no built-in default: an empty URL disables that feed, and its panel
# on the Nodes page and its node inventory source then report no data.
# DNS seeder discovery records, e.g. https://seeder.example.com/nodes
DNS_SEEDER_API_URL=
# Monitored test nodes, e.g. https://seeder.example.com/fullnodes
PRE_RELEASE_NODES_API_URL=
# Sent as the X-API-Key header to PRE_RELEASE_NODES_API_URL. Required in
# production when that URL is set. Never expose this key to the browser.
PRE_RELEASE_NODES_API_KEY=

# Masternode hosting provider lookup (ASN / provider enrichment)
# Optional path to a MaxMind ASN database (.mmdb); requires the optional
# `maxmind` npm package.
GEOIP_ASN_MMDB=
IP_API_ENABLED=true
IP_API_BATCH_TIMEOUT_MS=4000
IP_API_MAX_BATCH_PER_CYCLE=3
# ip-api.com: the free tier uses plain HTTP. IP_API_HTTPS=true switches to the
# pro HTTPS endpoint and requires IP_API_KEY.
IP_API_HTTPS=false
IP_API_KEY=

# Market data
# MARKET_SOURCE: qutrade (default) or coingecko; COINGECKO_ID is used with coingecko.
MARKET_SOURCE=qutrade
COINGECKO_ID=
QUTRADE_API_BASE_URL=https://qutrade.io/api/v1
QUTRADE_PAIR_USDT=dfcn_usdt
QUTRADE_PAIR_BTC=dfcn_btc
QUTRADE_HISTORY_PAIR=dfcn_usdt
QUTRADE_TRADES_LIMIT=100

# Migration transparency
# MIGRATION_HOT_WALLET_ADDRESS overrides the built-in hot wallet address
# (empty = built-in default). MIGRATION_HOT_WALLET_ADDRESSES lists additional
# wallet-owned addresses (comma-separated).
MIGRATION_HOT_WALLET_ADDRESS=
MIGRATION_HOT_WALLET_ADDRESSES=

# Network noise monitor ingest (POST /api/v1/network-noise/ingest)
NETWORK_NOISE_MONITOR_ENABLED=false
# Comma-separated node=token entries. Each token must be at least 32 characters;
# at least one valid entry is required when the monitor is enabled.
NETWORK_NOISE_INGEST_TOKENS=
NETWORK_NOISE_OBSERVATION_TTL_DAYS=30
NETWORK_NOISE_STALE_AFTER_MS=180000
# Allowance for agent clocks ahead of the batch's first arrival (0-60000 ms).
NETWORK_NOISE_CLOCK_SKEW_MS=5000
# Structured v2 PoSe/DKG observations; independent of legacy noise retention.
POSE_OBSERVATION_TTL_DAYS=365
# Canonical v23 mainnet commitment collector. Opt in after reviewing RPC load.
POSE_CHAIN_COLLECTOR_ENABLED=false
POSE_CHAIN_START_HEIGHT=144888
POSE_CHAIN_BLOCKS_PER_RUN=50
POSE_CHAIN_CONFIRMATIONS=3
POSE_CHAIN_POLL_INTERVAL_MS=30000
POSE_CHAIN_REORG_MAX_DEPTH=128
POSE_CHAIN_MEMBERSHIP_RETRY_BLOCKS=5
# Hash-addressed historical PoSe state replay; adds full-list RPC work.
POSE_CHAIN_ATTRIBUTION_ENABLED=false
POSE_CHAIN_ATTRIBUTION_BLOCKS_PER_RUN=5

# Public base URL used by the server for canonical and Open Graph metadata.
# Client build variables (VITE_API_URL, VITE_ENABLE_TEST_PAGE and the bundle's
# own VITE_PUBLIC_SITE_URL) are read by Vite from client/.env or the shell at
# build time, not from this file.
VITE_PUBLIC_SITE_URL=https://deftrack.xyz

# Telegram bot (optional). Create a bot with @BotFather, then set the token and
# your numeric Telegram user ID; both must be set together. Leave both empty to
# disable the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Optional shell commands behind the bot's /reindex and /daemonstatus commands.
# They run as the app's service account; leave them empty to disable both
# commands. /daemonstatus replies with the command's standard output.
TELEGRAM_REINDEX_COMMAND=
TELEGRAM_DAEMON_STATUS_COMMAND=
